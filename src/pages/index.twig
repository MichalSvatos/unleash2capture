{% extends 'layouts/main.twig' %}
{% from "utils/macros.twig" import component, icon_svg %}
{% block content %}
	{% set heroData = {
		"icon" : "ico-about",
		"text" : "We facilitate connection between an opportunity and realization<br>
<span class='text-highlight'>Unleashing the former</span> and <span class='text-highlight'>capturing the latter</span><br>
Whether it’s an investor looking for new opportunities
<br>Or a business ready to expand<br>Or a founder who is thinking what the next step should be",
		"videoName" : "hero-video",
		"companyName" : company
	} %}

	{% set servicesData = {
		"title" : "Services",
		"icon" : "ico-services",
		"services" : [
			{
				"title" : "Strategic advisory",
				"desc" : [
					"We facilitate access to investors, support new deal ideation, and provide insight into active market opportunities.",
					"We collaborate with private equity partners to identify and evaluate potential investments, and work closely with company founders and executives to raise capital from aligned and strategic funding partners"
				]
			},
			{
				"title" : "Talent Strategy",
				"desc" : ["We partner with company executives to shape workforce strategy and planning, design total rewards frameworks, and advise on board and executive compensation. We also support (new) owners and management teams with talent due diligence, and help address organizational and interpersonal challenges to ensure cohesive team dynamics and individual effectiveness."]
			},
			{
				"title" : "Digitization of Human Capital Processes",
				"desc" : ["We collaborate with leading HR technology partners to modernize internal systems, leveraging the latest data-driven platforms to enhance efficiency, transparency, and strategic decision-making."]
			},
			{
				"title" : "Insurance Strategy",
				"desc" : ["We provide insurance solutions to our counterparts including industry insurance, life & health insurance for individuals and corporations via affiliated insurance consultants"]
			}
		]
	} %}

	{% set contactData = {
		"title" : "Contact me",
		"icon" : "ico-contact",
		"name" : companyRepresentative,
		"position" : "Managing partner",
		"emailBox" : {
			"email" : companyEmail,
			"icon" : "ico-email"
		},
		"phoneBox" : {
			"phone" : companyPhone,
			"icon" : "ico-phone"
		}
	} %}

	{{ component('hero', {'heroData' : heroData}) }}
	{{ component('services', {'servicesData' : servicesData}) }}
	{{ component('contact', {'contactData' : contactData}) }}

{% endblock %}
